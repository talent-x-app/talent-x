{
  "expo": {
    "name": "Talent-X",
    "slug": "talent-x",
    "owner": "talent-x",
    "scheme": "talentx",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": ["ios", "android", "web"],
    "android": {
      "package": "com.talentx.app",
      "googleServicesFile": "./google-services.json"
    },
    "ios": {
      "bundleIdentifier": "com.talentx.app"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Autorise Talent-X à utiliser la caméra pour scanner le QR d'invitation d'un groupe."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ac859192-b5db-4d46-9e25-959958791804"
      }
    }
  }
}
