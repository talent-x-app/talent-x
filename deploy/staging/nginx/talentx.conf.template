# Reverse proxy Nginx — staging Talent-X (TX-DEPLOY-004 §3, TX-SEC-003 §11).
#
# Template : ${API_HOST} et ${STORAGE_HOST} sont substitués au démarrage par
# l'entrypoint officiel de l'image Nginx (fichiers de /etc/nginx/templates).
# Aucun nom d'hôte en dur — il change entre staging et production.
#
# Exigences TX-SEC-003 §11 appliquées ici : « TLS 1.3, HSTS et rejet du HTTP
# clair en production ». Le HTTP n'est conservé que pour le renouvellement ACME.

# ─────────────────────────── HTTP : ACME + redirection ───────────────────────
server {
    listen 80;
    listen [::]:80;
    server_name ${API_HOST} ${STORAGE_HOST};

    # Seule ressource servie en clair : le défi ACME de Let's Encrypt.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Tout le reste est redirigé. 301 et non 302 : la redirection est permanente
    # et doit être mise en cache par les clients.
    location / {
        return 301 https://$host$request_uri;
    }
}

# ───────────────────────────────── API ───────────────────────────────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${API_HOST};

    ssl_certificate     /etc/letsencrypt/live/${API_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${API_HOST}/privkey.pem;

    # TLS 1.3 uniquement. 1.2 est encore courant, mais la spec impose 1.3 et le
    # parc visé (iOS 13+/Android 8+) le gère : autant ne pas ouvrir la porte.
    ssl_protocols TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:TalentX:10m;
    ssl_session_tickets off;

    # HSTS. `includeSubDomains` couvre aussi l'hôte de stockage.
    # Pas de `preload` en staging : l'inscription à la liste est difficile à annuler.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    # Les archives d'export RGPD peuvent être volumineuses ; les avatars aussi.
    client_max_body_size 25m;

    # Aucune bannière de version en réponse.
    server_tokens off;

    location / {
        proxy_pass http://api:3000;
        proxy_http_version 1.1;

        # `$host` et non `$http_host` : conserve le nom demandé pour que l'API
        # construise des liens corrects derrière le proxy.
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Les exports et les téléversements peuvent dépasser les défauts (60 s).
        proxy_connect_timeout 10s;
        proxy_send_timeout    120s;
        proxy_read_timeout    120s;
    }
}

# ───────────────────────── Stockage objet (MinIO) ────────────────────────────
# Hôte SÉPARÉ, et non un chemin de l'API : les archives d'export sont livrées par
# URL présignée, dont la signature couvre l'hôte et le chemin. Servir MinIO sous
# un sous-chemin casserait la vérification de signature.
#
# C'est aussi la forme qu'aura OVH Object Storage en production — un endpoint
# distinct — donc le staging reste fidèle à la cible.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${STORAGE_HOST};

    ssl_certificate     /etc/letsencrypt/live/${API_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${API_HOST}/privkey.pem;

    ssl_protocols TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:TalentX:10m;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    server_tokens off;

    # Archives d'export : pas de limite basse, et pas de tampon (flux direct).
    client_max_body_size 0;
    proxy_buffering off;
    proxy_request_buffering off;

    location / {
        proxy_pass http://minio:9000;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 10s;
        proxy_send_timeout    300s;
        proxy_read_timeout    300s;
    }
}
