# Configuration du staging Talent-X — MODÈLE.
#
# Le fichier réel vit HORS DÉPÔT, sur le VPS :
#   /etc/talentx/staging.env   —   chown root:root, chmod 600
#
# Décision assumée pour le staging (TX-SEC-003 §11 « Outil à choisir ») : pas de
# coffre à secrets, un fichier protégé suffit. Cette réponse NE VAUT PAS pour la
# production, où un gestionnaire de secrets reste à arrêter.
#
# La liste ci-dessous n'est pas devinée : elle vient de la validation au
# démarrage (`apps/api/src/config/env.validation.ts`), qui refuse de démarrer si
# la configuration est incomplète. `NODE_ENV=staging` y est traité EXACTEMENT
# comme `production` — mêmes exigences.

# ─────────────────────────────── Application ────────────────────────────────
NODE_ENV=staging
PORT=3000

# URL publique de l'app — base des liens transactionnels (réinitialisation de
# mot de passe, TLX-104). Requis en staging.
APP_PUBLIC_URL=https://staging-api.example.org

# ──────────────────────────────── Déploiement ───────────────────────────────
# Noms d'hôte servis par Nginx. STORAGE_HOST est distinct : les URL présignées
# signent l'hôte, un sous-chemin casserait la signature.
API_HOST=staging-api.example.org
STORAGE_HOST=staging-storage.example.org

# Image publiée par la CI. TOUJOURS un SHA de commit, jamais `latest` : sinon un
# simple redémarrage change de version sans que personne ne l'ait décidé.
API_IMAGE=ghcr.io/talent-x-app/talentx-api
IMAGE_TAG=

# ───────────────────────────────── PostgreSQL ───────────────────────────────
POSTGRES_USER=talentx
POSTGRES_PASSWORD=
POSTGRES_DB=talentx
# L'hôte est le nom du service Docker, pas localhost.
DATABASE_URL=postgresql://talentx:CHANGEME@postgres:5432/talentx?schema=public

# ─────────────────────────────────── Redis ──────────────────────────────────
# Requis en staging : file de jobs BullMQ (ADR-09/13). Le worker ne démarre pas
# sans elle, et l'API y produit les jobs de notification, d'email et d'export.
REDIS_URL=redis://redis:6379

# ──────────────────────── Stockage objet (MinIO au staging) ─────────────────
# Les cinq variables sont requises — tout-ou-rien.
#
# S3_ENDPOINT est l'URL PUBLIQUE, pas l'adresse interne : c'est elle qui est
# signée dans les URL présignées des archives d'export. Avec `http://minio:9000`
# le lien serait injoignable depuis un téléphone.
S3_ENDPOINT=https://staging-storage.example.org
S3_REGION=us-east-1
S3_BUCKET=talentx-exports
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Durées de vie des archives d'export (défauts sûrs, surchargeables).
EXPORT_ARCHIVE_TTL_HOURS=24
EXPORT_URL_TTL_SECONDS=86400

# Rétention avant purge définitive d'un compte supprimé (TLX-034 / ADR-15).
# 30 jours = durée de rétention des sauvegardes (TX-SEC-003 §9.2).
ACCOUNT_PURGE_RETENTION_DAYS=30

# ──────────────────────────── Signature des jetons ──────────────────────────
# Clé privée RS256 au format PEM PKCS#8. Requise en staging.
# À générer :  pnpm --filter @talent-x/api keys:generate
# Les sauts de ligne peuvent être échappés en \n sur une seule ligne.
#
# NE JAMAIS réutiliser la clé de production en staging : un jeton émis par l'un
# serait accepté par l'autre.
JWT_PRIVATE_KEY=
# Optionnel — dérivé du thumbprint RFC 7638 si absent.
JWT_KEY_ID=
# Optionnel — clés publiques encore acceptées en vérification pendant une
# rotation, au format JSON [{ kid, publicKey }].
JWT_ADDITIONAL_PUBLIC_KEYS=

# ─────────────────────────────── Divers ─────────────────────────────────────
# Version des textes de consentement (TLX-031). À incrémenter quand un texte
# change, pour tracer la base juridique (TX-SEC-003 §6).
CONSENT_TEXT_VERSION=2026-01

# Optionnel — si défini, `GET /metrics` exige un Bearer valide (TLX-83).
# Recommandé dès le staging : l'endpoint est joignable publiquement.
METRICS_TOKEN=

# ──────────────────────── Notifications push (optionnel) ────────────────────
# Absents → le worker retombe sur LoggingPushProvider. Chaque plateforme est
# TOUT-OU-RIEN : une configuration partielle fait échouer le démarrage.
#
# APNS_PRODUCTION doit correspondre à l'entitlement `aps-environment` du BUILD
# installé, pas à l'environnement serveur. Profil AdHoc ou App Store →
# production. Un jeton de production envoyé au sandbox renvoie 400
# BadDeviceToken — soit exactement le message d'un « échec attendu ».
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY=
APNS_PRODUCTION=true

# Prérequis côté Google Cloud, sans lesquels ces variables ne suffisent pas :
# API fcm.googleapis.com activée, et rôle roles/cloudmessaging.messagesPublisher
# sur le compte de service. Diagnostic : pnpm tsx scripts/push-smoke.ts
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ────────────────────── Email transactionnel (optionnel) ────────────────────
# Brevo (UE — TLX-128). Absents → LoggingEmailProvider. Tout-ou-rien.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
